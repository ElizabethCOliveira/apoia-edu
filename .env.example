# Copie para .env e preencha. Nunca faça commit do .env com valores reais.

# Chave da API Gemini (https://aistudio.google.com/). Sem ela, a demo usa só os exemplos prontos.
GEMINI_API_KEY=""

# Opcional: troca os modelos de texto sem mexer no código.
# GEMINI_MODEL=""
# GEMINI_FALLBACK_MODEL=""

# Opcional: URL pública do app, usada nos links de convite e de recuperação de senha.
# Sem ela, o servidor usa o endereço da própria requisição.
# APP_URL=""

# Opcional: pasta do banco SQLite e dos anexos (padrão: ./storage). Nunca é servida publicamente.
# STORAGE_ROOT=""

# Opcional: cria o primeiro administrador LumiNext quando o banco ainda não tem nenhum.
# Também pode usar `npm run admin:init`. Nunca faça commit de credenciais reais.
LUMINEXT_ADMIN_EMAIL=""
LUMINEXT_ADMIN_PASSWORD=""
LUMINEXT_ADMIN_NAME=""
